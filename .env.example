# TimescaleDB connection. Fill in real values in .env (never committed).
# No real hostnames, IPs, or credentials in this file: the repository is public.
DB_HOST=db-host-placeholder
DB_PORT=5432
DB_NAME=db-name-placeholder
DB_USER=db-user-placeholder
DB_PASSWORD=db-password-placeholder

# Optional: port for the local API server (defaults to 5273, distinct from
# the Vite dev server on 5173).
# API_PORT=5273

# Approximate location; set exact values in your local .env only
EMS_LAT=51.67
EMS_LON=4.79

# AI insight via the Mistral API; real values live only in your local .env
MISTRAL_API_KEY=replace-with-your-key
# Shared daily cap for all AI insight widgets (default 100)
MISTRAL_DAILY_CALL_LIMIT=100

# The advisory monologue area (the hub's single advisory surface):
# the summary API serves the monologue sections only while this is
# on. Off by default; without it the advisory area renders nothing
# and the prices widget stands alone. Read once at server startup.
# EMS_ADVISORY_MONOLOGUE=1

# Home Assistant REST API for the price forecast; real values live only in
# your local .env
HA_URL=http://your-home-assistant:8123
HA_TOKEN=replace-with-your-token
ZONNEPLAN_PRICE_ENTITY=sensor.zonneplan_current_quarter_hourly_electricity_tariff
ZONNEPLAN_PRICES_TOMORROW_STATUS_ENTITY=sensor.zonneplan_electricity_prices_tomorrow_status

# Battery usable capacity in kWh, for the charge/discharge time estimates
BATTERY_CAPACITY_KWH=7

# Export earnings on the Solar page's cost mode are priced per hour at
# Zonneplan's dynamic return price (see README): the hour's market
# price - derived from the all-in consumption price - plus the
# feed-in handling fee, with the Zonnebonus in positive daytime
# hours. The constants below are the 2026 defaults; review them each
# January (the energy tax changes) and against each annual
# settlement. Invalid values fall back to the defaults.
# EMS_RETURN_ENERGY_TAX_EUR=0.11085
# EMS_RETURN_HANDLING_FEE_CONSUMPTION_EUR=0.0165
# EMS_RETURN_HANDLING_FEE_FEED_IN_EUR=0.02
# EMS_RETURN_SOLAR_BONUS=0.10
# EMS_RETURN_BONUS_START_HOUR=7
# EMS_RETURN_BONUS_END_HOUR=18

# Flat override in EUR/kWh: a positive value replaces the dynamic
# construction entirely. The dashboard runs in dynamic mode and
# leaves this unset; it exists only as an explicit override.
# EMS_FEED_IN_TARIFF_EUR=

# Production serving (mini PC): the server also serves the built frontend
# and binds to this host and port. Defaults: HOST=0.0.0.0, PORT=5273.
# PORT=8080
# HOST=0.0.0.0
