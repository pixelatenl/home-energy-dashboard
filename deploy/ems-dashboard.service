[Unit]
Description=EMS dashboard web server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=YOUR_USER
WorkingDirectory=/home/YOUR_USER/home-energy-dashboard/server
EnvironmentFile=/home/YOUR_USER/home-energy-dashboard/server/.env
ExecStart=/usr/bin/node index.mjs
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
